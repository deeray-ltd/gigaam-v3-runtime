FROM ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316 AS build-tools

ADD --checksum=sha256:6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50 https://snapshot.ubuntu.com/ubuntu/20260827T000000Z/pool/main/c/ca-certificates/ca-certificates_20260601~24.04.1_all.deb /tmp/ca-certificates.deb

RUN dpkg-deb --extract /tmp/ca-certificates.deb /tmp/ca-certificates \
    && mkdir --parents /etc/ssl/certs \
    && cat /tmp/ca-certificates/usr/share/ca-certificates/mozilla/*.crt > /etc/ssl/certs/ca-certificates.crt \
    && sed --in-place \
        -e 's|http://archive.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20260827T000000Z/|' \
        -e 's|http://security.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20260827T000000Z/|' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && sed --in-place '/^Signed-By:/a Snapshot: no' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install --yes --no-install-recommends binutils gcc libc6-dev unzip \
    && rm -rf /var/lib/apt/lists/* /tmp/ca-certificates /tmp/ca-certificates.deb

FROM build-tools AS builder

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:${PATH}

ADD --checksum=sha256:4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10 https://static.rust-lang.org/rustup/archive/1.29.0/x86_64-unknown-linux-gnu/rustup-init /tmp/rustup-init

RUN chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-host x86_64-unknown-linux-gnu --default-toolchain 1.98.0 \
    && rm /tmp/rustup-init \
    && cargo --version

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,id=gigaam-v3-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=gigaam-v3-cargo-target-tensorrt,target=/src/target,sharing=locked \
    cargo build --locked --release --package gigaam-service --no-default-features --features tensorrt \
    && strip --strip-unneeded target/release/asr-serve \
    && install --directory /out \
    && install --mode=0755 target/release/asr-serve /out/asr-serve

FROM build-tools AS ort

ADD --checksum=sha256:3d01949bc846d41961b37988d1e63d782a6effcb93b650a6e0577fef982d38b5 https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime.gpu.linux/1.32.0/microsoft.ml.onnxruntime.gpu.linux.1.32.0.nupkg /tmp/onnxruntime.nupkg

RUN mkdir --parents /opt/ort/lib \
    && unzip -j /tmp/onnxruntime.nupkg \
        runtimes/linux-x64/native/libonnxruntime.so \
        runtimes/linux-x64/native/libonnxruntime_providers_shared.so \
        runtimes/linux-x64/native/libonnxruntime_providers_cuda.so \
        runtimes/linux-x64/native/libonnxruntime_providers_tensorrt.so \
        -d /opt/ort/lib \
    && mv /opt/ort/lib/libonnxruntime.so /opt/ort/lib/libonnxruntime.so.1.32.0 \
    && ln -s libonnxruntime.so.1.32.0 /opt/ort/lib/libonnxruntime.so.1 \
    && ln -s libonnxruntime.so.1 /opt/ort/lib/libonnxruntime.so \
    && unzip -j /tmp/onnxruntime.nupkg LICENSE ThirdPartyNotices.txt -d /opt/ort \
    && rm /tmp/onnxruntime.nupkg

FROM ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316 AS tensorrt

ADD --checksum=sha256:3d2caaf0796fab517fffea327727ef829f46510fb1cd6bcd0efc84cb3b1ef002 https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/libnvinfer10_10.16.1.11-1+cuda13.2_amd64.deb /tmp/libnvinfer10.deb
ADD --checksum=sha256:05ea299164a1985c7f7cdfd3e218d3fa25a0be43d784fb16b6bc3d3fa29c4938 https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/libnvinfer-plugin10_10.16.1.11-1+cuda13.2_amd64.deb /tmp/libnvinfer-plugin10.deb
ADD --checksum=sha256:cd379a1d03d92f104d5659e0cb62302a781a17806ba103c01a699da5c8648dd6 https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/libnvonnxparsers10_10.16.1.11-1+cuda13.2_amd64.deb /tmp/libnvonnxparsers10.deb

# Ship the libraries used to load existing engines and preserve their SONAME links.
RUN dpkg-deb --extract /tmp/libnvinfer10.deb /tmp/tensorrt \
    && dpkg-deb --extract /tmp/libnvinfer-plugin10.deb /tmp/tensorrt \
    && dpkg-deb --extract /tmp/libnvonnxparsers10.deb /tmp/tensorrt \
    && mkdir --parents /opt/tensorrt /opt/tensorrt-notices \
    && cp --no-dereference /tmp/tensorrt/usr/lib/x86_64-linux-gnu/libnvinfer.so.10* \
        /tmp/tensorrt/usr/lib/x86_64-linux-gnu/libnvinfer_plugin.so.10* \
        /tmp/tensorrt/usr/lib/x86_64-linux-gnu/libnvonnxparser.so.10* /opt/tensorrt/ \
    && cp --archive /tmp/tensorrt/usr/share/doc/libnvinfer10 \
        /tmp/tensorrt/usr/share/doc/libnvinfer-plugin10 \
        /tmp/tensorrt/usr/share/doc/libnvonnxparsers10 /opt/tensorrt-notices/ \
    && rm -rf /tmp/tensorrt /tmp/libnvinfer10.deb /tmp/libnvinfer-plugin10.deb /tmp/libnvonnxparsers10.deb

FROM nvidia/cuda:13.5.0-cudnn-runtime-ubuntu24.04@sha256:6c863df514b3ec495d60ffe89380af2bec3d13a14fde43dab02563a0f5f1a5fd

RUN groupadd --gid 10001 gigaam \
    && useradd --uid 10001 --gid gigaam --no-create-home --home-dir /app --shell /usr/sbin/nologin gigaam \
    && mkdir --parents /app/trt-cache \
    && chown gigaam:gigaam /app/trt-cache

WORKDIR /app
COPY --from=builder --chmod=755 /out/asr-serve /app/asr-serve
COPY --from=ort /opt/ort/lib/ /app/ort/lib/
COPY --from=tensorrt /opt/tensorrt/ /app/tensorrt/
COPY --from=ort /opt/ort/LICENSE /usr/share/licenses/gigaam-v3-runtime/onnxruntime/LICENSE
COPY --from=ort /opt/ort/ThirdPartyNotices.txt /usr/share/licenses/gigaam-v3-runtime/onnxruntime/ThirdPartyNotices.txt
COPY --from=tensorrt /opt/tensorrt-notices/ /usr/share/licenses/gigaam-v3-runtime/tensorrt/
COPY COPYING COPYING.LESSER THIRD_PARTY.md /usr/share/licenses/gigaam-v3-runtime/
COPY crates/service/licenses/rust/ /usr/share/licenses/gigaam-v3-runtime/rust/
COPY crates/model-package/licenses/sentencepiece/ /usr/share/licenses/gigaam-v3-runtime/sentencepiece/

ENV ASR_ENCODER_EP=tensorrt \
    ASR_TRT_CACHE=/app/trt-cache \
    LD_LIBRARY_PATH=/app/ort/lib:/app/tensorrt:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    ORT_DYLIB_PATH=/app/ort/lib/libonnxruntime.so.1.32.0

LABEL org.opencontainers.image.title="GigaAM v3 Runtime (TensorRT)" \
      org.opencontainers.image.description="GigaAM v3 speech-recognition service and CLI, ONNX Runtime TensorRT provider" \
      org.opencontainers.image.source="https://github.com/deeray-ltd/gigaam-v3-runtime" \
      org.opencontainers.image.url="https://github.com/deeray-ltd/gigaam-v3-runtime" \
      org.opencontainers.image.documentation="https://github.com/deeray-ltd/gigaam-v3-runtime/blob/main/docs/OPERATIONS.md" \
      org.opencontainers.image.vendor="Deeray Ltd." \
      org.opencontainers.image.licenses="LGPL-3.0-or-later" \
      org.opencontainers.image.version="0.1.1"
EXPOSE 8080
USER gigaam
ENTRYPOINT ["/app/asr-serve", "--model", "/app/model", "--port", "8080"]
