FROM ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316 AS builder

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:${PATH}

ADD --checksum=sha256:6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50 https://snapshot.ubuntu.com/ubuntu/20260827T000000Z/pool/main/c/ca-certificates/ca-certificates_20260601~24.04.1_all.deb /tmp/ca-certificates.deb

RUN dpkg-deb --extract /tmp/ca-certificates.deb /tmp/ca-certificates \
    && mkdir --parents /etc/ssl/certs \
    && cat /tmp/ca-certificates/usr/share/ca-certificates/mozilla/*.crt > /etc/ssl/certs/ca-certificates.crt \
    && sed --in-place \
        -e 's|http://archive.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20260827T000000Z/|' \
        -e 's|http://security.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20260827T000000Z/|' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && sed --in-place '/^Signed-By:/a Snapshot: no' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install --yes --no-install-recommends binutils gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/ca-certificates /tmp/ca-certificates.deb

ADD --checksum=sha256:4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10 https://static.rust-lang.org/rustup/archive/1.29.0/x86_64-unknown-linux-gnu/rustup-init /tmp/rustup-init

RUN chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-host x86_64-unknown-linux-gnu --default-toolchain 1.98.0 \
    && rm /tmp/rustup-init \
    && cargo --version

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,id=gigaam-v3-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=gigaam-v3-cargo-target-cuda,target=/src/target,sharing=locked \
    cargo build --locked --release --package gigaam-service --no-default-features --features cuda \
    && strip --strip-unneeded target/release/asr-serve \
    && install --directory /out \
    && install --mode=0755 target/release/asr-serve /out/asr-serve

FROM ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316 AS ort

ADD --checksum=sha256:844c64acfc43ab9423215c26493055ea229268e28283146cc644ecef0bdae048 https://github.com/microsoft/onnxruntime/releases/download/v1.29.0/onnxruntime-linux-x64-gpu_cuda13-1.29.0.tgz /tmp/onnxruntime.tgz

RUN mkdir --parents /opt/ort \
    && tar --extract --gzip --file /tmp/onnxruntime.tgz --directory /opt/ort --strip-components=1 \
        onnxruntime-linux-x64-gpu_cuda13-1.29.0/lib/libonnxruntime.so \
        onnxruntime-linux-x64-gpu_cuda13-1.29.0/lib/libonnxruntime.so.1 \
        onnxruntime-linux-x64-gpu_cuda13-1.29.0/lib/libonnxruntime.so.1.29.0 \
        onnxruntime-linux-x64-gpu_cuda13-1.29.0/lib/libonnxruntime_providers_shared.so \
        onnxruntime-linux-x64-gpu_cuda13-1.29.0/lib/libonnxruntime_providers_cuda.so \
        onnxruntime-linux-x64-gpu_cuda13-1.29.0/LICENSE \
        onnxruntime-linux-x64-gpu_cuda13-1.29.0/ThirdPartyNotices.txt \
    && rm /tmp/onnxruntime.tgz

FROM nvidia/cuda:13.0.2-cudnn-runtime-ubuntu24.04@sha256:4d242f206abc4b9588a6506cce2d88932cc879849395aae3785075179718cc49

RUN groupadd --gid 10001 gigaam \
    && useradd --uid 10001 --gid gigaam --no-create-home --home-dir /app --shell /usr/sbin/nologin gigaam

WORKDIR /app
COPY --from=builder --chmod=755 /out/asr-serve /app/asr-serve
COPY --from=ort /opt/ort/lib/ /app/ort/lib/
COPY --from=ort /opt/ort/LICENSE /usr/share/licenses/gigaam-v3-runtime/onnxruntime/LICENSE
COPY --from=ort /opt/ort/ThirdPartyNotices.txt /usr/share/licenses/gigaam-v3-runtime/onnxruntime/ThirdPartyNotices.txt
COPY COPYING COPYING.LESSER THIRD_PARTY.md /usr/share/licenses/gigaam-v3-runtime/
COPY crates/service/licenses/rust/ /usr/share/licenses/gigaam-v3-runtime/rust/

ENV ASR_ENCODER_EP=cuda \
    LD_LIBRARY_PATH=/app/ort/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    ORT_DYLIB_PATH=/app/ort/lib/libonnxruntime.so.1.29.0

LABEL org.opencontainers.image.title="GigaAM v3 Runtime (CUDA)" \
      org.opencontainers.image.description="GigaAM v3 speech-recognition service and CLI, ONNX Runtime CUDA provider" \
      org.opencontainers.image.source="https://github.com/deeray-ltd/gigaam-v3-runtime" \
      org.opencontainers.image.url="https://github.com/deeray-ltd/gigaam-v3-runtime" \
      org.opencontainers.image.documentation="https://github.com/deeray-ltd/gigaam-v3-runtime/blob/main/docs/OPERATIONS.md" \
      org.opencontainers.image.vendor="Deeray Ltd." \
      org.opencontainers.image.licenses="LGPL-3.0-or-later" \
      org.opencontainers.image.version="0.1.1"
EXPOSE 8080
USER gigaam
ENTRYPOINT ["/app/asr-serve", "--model", "/app/model", "--port", "8080"]
